# Copy to .env and fill in. Real environment variables override this file.
FIREWORKS_API_KEY=
# Exact Fireworks model IDs: confirm with the organizers / Fireworks model page.
FORESIGHT_MODEL=accounts/fireworks/models/REPLACE-gemma-vision-model
FORESIGHT_MODEL_SMALL=
FORESIGHT_MODEL_LARGE=
# Your teammate's fine-tuned Gemma 4 12B deployment (Variant E)
FORESIGHT_MODEL_FT=
FORESIGHT_CONCURRENCY=8
FORESIGHT_MAX_REPLANS=2
FORESIGHT_FAIL_CLOSED=1
# Thinking models: same effort for every variant ("" to omit)
FORESIGHT_REASONING_EFFORT=low
